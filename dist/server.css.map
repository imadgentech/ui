.imui_Footer_footer__ZLfTUC {
    padding: 18px 0 22px;
    border-top: 1px solid rgba(255, 255, 255, .08);
    width: 100%;
}

@media (min-width: 1025px) {
    .imui_Footer_footer__ZLfTUC {
        width: calc(100% - var(--sidebar-width, 0px));
        margin-left: var(--sidebar-width, 0px);
    }
}

[data-theme="light"] .imui_Footer_footer__ZLfTUC {
    border-top: 1px solid rgba(10, 10, 10, .08);
    background: #F4E6DD;
}

.imui_Footer_finebar__IPKkgi {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--muted2);
    font-size: 12px;
}

.imui_Footer_fineLeft__CKTvvT {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 240px;
}

.imui_Footer_fineRight__Lxvzuz {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
}

.imui_Footer_socials__yiGvl2 {
    display: flex;
    align-items: center;
    gap: 10px;
}

.imui_Footer_iconBtn__OV8F7M {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--btnBorder);
    background: var(--btnBg);
    display: grid;
    place-items: center;
    transition: transform .15s ease, background .2s ease, border-color .2s ease;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .10);
    color: inherit;
}

.imui_Footer_iconBtn__OV8F7M:hover {
    transform: translateY(-1px);
    background: var(--btnHover);
    border-color: color-mix(in srgb, var(--btnBorder) 60%, rgba(255, 106, 0, .20));
}

.imui_Footer_iconBtn__OV8F7M svg {
    width: 18px;
    height: 18px;
    opacity: .86;
}

.imui_Footer_footmark__KE71uh {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 10px;
    border-left: 1px solid var(--line);
    margin-left: 2px;
}

.imui_Footer_logo__qaBxdC {
    width: 22px;
    height: 22px;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(255, 106, 0, .18));
    opacity: .9;
    display: flex;
    align-items: center;
    justify-content: center;
}

.imui_Footer_logo__qaBxdC img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.imui_Footer_logo__qaBxdC .logo-light {
    display: none;
}

[data-theme="light"] .imui_Footer_logo__qaBxdC .logo-dark {
    display: none;
}

[data-theme="light"] .imui_Footer_logo__qaBxdC .logo-light {
    display: block;
}

.imui_Footer_brandName__grh2v6 {
    letter-spacing: .14em;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
    color: var(--muted);
}
