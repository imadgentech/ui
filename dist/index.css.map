.imui_Accordion_root__ZKpusI {
    width: 100%;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-surface);
}

.imui_Accordion_item__ZMopXX {
    border-bottom: 1px solid var(--color-border-default);
}

.imui_Accordion_item__ZMopXX:last-child {
    border-bottom: none;
}

.imui_Accordion_header__LwUjAO {
    margin: 0;
}

.imui_Accordion_trigger__lkDEdm {
    all: unset;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-16) var(--space-20);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    color: var(--color-text-default);
    cursor: pointer;
    box-sizing: border-box;
    transition: background 0.2s ease;
}

.imui_Accordion_trigger__lkDEdm:hover {
    background: var(--color-bg-surface-hover);
}

.imui_Accordion_trigger__lkDEdm:focus-visible {
    background: var(--color-bg-surface-hover);
    box-shadow: inset 0 0 0 2px var(--color-brand-primary);
}

.imui_Accordion_chevron__-Q2lFD {
    transition: transform 0.3s cubic-bezier(0.87, 0, 0.13, 1);
    color: var(--color-text-muted);
}

.imui_Accordion_trigger__lkDEdm[data-state='open'] .imui_Accordion_chevron__-Q2lFD {
    transform: rotate(180deg);
}

.imui_Accordion_content__dLof7Y {
    overflow: hidden;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    background: rgba(255, 255, 255, 0.01);
}

.imui_Accordion_contentInner__PCuZXG {
    padding: 0 var(--space-20) var(--space-20);
}

.imui_Accordion_content__dLof7Y[data-state='open'] {
    animation: imui_Accordion_slideDown__xn2zGq 0.3s ease-out;
}

.imui_Accordion_content__dLof7Y[data-state='closed'] {
    animation: imui_Accordion_slideUp__nBa8hr 0.3s ease-out;
}

@keyframes imui_Accordion_slideDown__xn2zGq {
    from {
        height: 0;
    }

    to {
        height: var(--radix-accordion-content-height);
    }
}

@keyframes imui_Accordion_slideUp__nBa8hr {
    from {
        height: var(--radix-accordion-content-height);
    }

    to {
        height: 0;
    }
}
