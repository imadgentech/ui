.imui_Textarea_textarea__iMPpJB {
    font-family: var(--font-sans);
    background: var(--color-bg-surface);
    color: var(--color-text-default);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    min-height: 80px;
}

.imui_Textarea_textarea__iMPpJB:hover:not(:disabled) {
    border-color: var(--color-border-hover);
}

.imui_Textarea_textarea__iMPpJB:focus {
    outline: none;
    border-color: var(--color-brand-primary);
    box-shadow: var(--shadow-focus);
}

.imui_Textarea_textarea__iMPpJB:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.imui_Textarea_textarea__iMPpJB.imui_Textarea_invalid__vXxdVm {
    border-color: var(--color-error);
}

/* Resizing */
.imui_Textarea_resize-none__eAISnC {
    resize: none;
}

.imui_Textarea_resize-vertical__XXfDT1 {
    resize: vertical;
}

.imui_Textarea_resize-both__8FCT0s {
    resize: both;
}

/* Sizes */
.imui_Textarea_size-sm__zld2RH {
    padding: var(--space-8) var(--space-12);
    font-size: var(--text-sm);
}

.imui_Textarea_size-md__tymxqZ {
    padding: var(--space-12) var(--space-16);
    font-size: var(--text-md);
}

.imui_Textarea_size-lg__pNzdfx {
