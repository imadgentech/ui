.imui_Button_button___-kjOB {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s ease;
    cursor: pointer;
    border: 1px solid var(--color-border-default);
    background: transparent;
    color: var(--color-text-default);
    user-select: none;
    font-family: var(--font-sans);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .12);
}

.imui_Button_button___-kjOB:hover:not(:disabled) {
    transform: translateY(-1px);
    background: var(--color-bg-surface-hover);
    border-color: var(--color-border-hover);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .18);
}

.imui_Button_button___-kjOB:active:not(:disabled) {
    transform: translateY(0);
}

.imui_Button_button___-kjOB:disabled,
.imui_Button_button___-kjOB.imui_Button_loading__7xz92R {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

.imui_Button_button___-kjOB:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
}

