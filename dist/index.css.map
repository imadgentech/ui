.imui_MobileMenuContent_content__lygFFX {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-32) var(--space-24);
    gap: var(--space-32);
}

[data-theme="dark"] .imui_MobileMenuContent_content__lygFFX {
    --logoFilter: none;
}


.imui_MobileMenuContent_logoArea__CdBKRB {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
}

.imui_MobileMenuContent_logoArea__CdBKRB img {
    height: 48px;
    width: 48px;
    object-fit: contain;
    opacity: 1;
}

.imui_MobileMenuContent_logoArea__CdBKRB .logo-dark {
    display: block;
}

.imui_MobileMenuContent_logoArea__CdBKRB .logo-light {
    display: none;
}

[data-theme="light"] .imui_MobileMenuContent_logoArea__CdBKRB .logo-dark {
    display: none;
}

[data-theme="light"] .imui_MobileMenuContent_logoArea__CdBKRB .logo-light {
    display: block;
}

.imui_MobileMenuContent_logoArea__CdBKRB span {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-default);
}

.imui_MobileMenuContent_linksStack__uQolix {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: var(--space-8);
}

.imui_MobileMenuContent_navLink__Y2lF4F {
    font-size: 22px;
    font-weight: 400;
    color: var(--color-text-muted);
    padding: var(--space-12) 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: color 0.2s ease;
}

.imui_MobileMenuContent_navLink__Y2lF4F:hover {
    color: var(--color-text-default);
}

.imui_MobileMenuContent_navLink__Y2lF4F::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 60px;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--color-brand-primary), transparent);
    transform: translateX(-50%) scaleX(0) !important;
    opacity: 0 !important;
    transition: transform 0.3s ease, opacity 0.3s ease;
    display: block !important;
}

/* Force hide active state's persistent underline in burger menu */
.imui_MobileMenuContent_navLink.active__sIezqc::after {
    transform: translateX(-50%) scaleX(0) !important;
    opacity: 0 !important;
}

.imui_MobileMenuContent_navLink__Y2lF4F:hover::after {
    transform: translateX(-50%) scaleX(1) !important;
    opacity: 1 !important;
}

/* Ensure Home also follows these rules */
.imui_MobileMenuContent_navLink.active__nyYVwN:hover::after {
    transform: translateX(-50%) scaleX(1) !important;
    opacity: 1 !important;
}

.imui_MobileMenuContent_actions__AjqBzi {
    margin-top: var(--space-16);
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.imui_MobileMenuContent_actions__AjqBzi .btn {
    display: none !important;
}

.imui_MobileMenuContent_actions__AjqBzi .toggle {
    all: unset;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 20px;
    color: var(--color-text-muted);
    padding: var(--space-12) 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    transition: color 0.2s ease;
}

.imui_MobileMenuContent_actions__AjqBzi .toggle:hover {
    color: var(--color-text-default);
}

.imui_MobileMenuContent_actions__AjqBzi .toggle svg {
    width: 20px;
    height: 20px;
}

.imui_MobileMenuContent_logoArea__CdBKRB .logo-light {
    display: none;
}

[data-theme="light"] .imui_MobileMenuContent_logoArea__CdBKRB .logo-dark {
    display: none;
}

[data-theme="light"] .imui_MobileMenuContent_logoArea__CdBKRB .logo-light {
    display: block;
}
