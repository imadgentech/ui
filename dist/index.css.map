.imui_Divider_divider__QkLooP {
  display: inline-block;
  background: linear-gradient(
    to right,
    transparent,
    currentColor,
    transparent
  );
  transition: all 0.3s ease;
}

.imui_Divider_divider__QkLooP.imui_Divider_horizontal__AiA4IO {
  width: 100%;
  height: calc(1px * var(--divider-scale, 1));
  min-height: 1px;
}

.imui_Divider_divider__QkLooP.imui_Divider_vertical__dEEyeg {
  height: 100%;
  width: calc(1px * var(--divider-scale, 1));
  min-width: 1px;
  background: linear-gradient(
    to bottom,
    transparent,
    currentColor,
    transparent
  );
}

/* Responsive scaling - gets thinner on mobile */
@media (max-width: 768px) {
  .imui_Divider_divider__QkLooP.imui_Divider_horizontal__AiA4IO {
    height: calc(0.5px * var(--divider-scale, 1));
  }

  .imui_Divider_divider__QkLooP.imui_Divider_vertical__dEEyeg {
    width: calc(0.5px * var(--divider-scale, 1));
  }
}
