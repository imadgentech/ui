.imui_Avatar_avatar__LjmObW {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-surface-hover);
    color: var(--color-brand-primary);
    font-weight: var(--font-bold);
    font-family: var(--font-sans);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--color-border-default);
}

.imui_Avatar_image__NaxqRV {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.imui_Avatar_fallback__KI-HmM {
    text-transform: uppercase;
    user-select: none;
}

/* Shapes */
.imui_Avatar_shape-circle__Q2PSya {
    border-radius: var(--radius-full);
}

.imui_Avatar_shape-square__1C8TQG {
    border-radius: var(--radius-md);
}

/* Sizes */
.imui_Avatar_size-sm__RWAm54 {
    width: 32px;
    height: 32px;
    font-size: 12px;
}

.imui_Avatar_size-md__tr_3WE {
    width: 40px;
    height: 40px;
    font-size: 14px;
}

.imui_Avatar_size-lg__P6JeNN {
    width: 56px;
    height: 56px;
    font-size: 18px;
}

.imui_Avatar_size-xl__SQuqJu {
