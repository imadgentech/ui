.imui_Navbar_navbar__FsFYSn {
    height: var(--navbar-height);
    background: var(--navbar-bg, rgba(5, 5, 5, 0.85));
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-default);
    display: flex;
    align-items: center;
    z-index: var(--z-navbar);
    width: 100%;
    transition: all 0.3s ease;
}

.imui_Navbar_sticky__5eHQI5 {
    position: fixed;
    top: 0;
    left: 0;
}

.imui_Navbar_container__Ytp59N {
    padding: var(--space-16) var(--space-32);
    width: 100%;
    height: 100%;
}

.imui_Navbar_flex__DoMTUn {
    height: 100%;
}

.imui_Navbar_brand__Tlwqy8 {
    display: flex;
    align-items: center;
}

.imui_Navbar_brand__Tlwqy8 .logo-light {
    display: none;
}

[data-theme="light"] .imui_Navbar_brand__Tlwqy8 .logo-dark {
    display: none;
}

[data-theme="light"] .imui_Navbar_brand__Tlwqy8 .logo-light {
    display: block;
}

.imui_Navbar_desktopNav__U8aE24 {
    display: none;
}

.imui_Navbar_rightSection__zkgOeZ {
    display: flex;
    align-items: center;
    gap: var(--space-32);
}

.imui_Navbar_actions__YCakXP {
    display: none;
}

.imui_Navbar_mobileNav__NQywwb {
    display: block;
}

.imui_Navbar_burger__7rNcW3 {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: calc(var(--z-modal) + 1);
    color: var(--color-text-default);
}

.imui_Navbar_burger__7rNcW3 svg {
    display: block;
    width: 28px;
    height: 28px;
    color: var(--color-text-default);
/* removed invalid extra closing brace */
}

.imui_Navbar_burger__7rNcW3 span {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--color-text-default);
    transition: 0.3s;
}

@media (min-width: 1024px) {
    .imui_Navbar_desktopNav__U8aE24 {
        display: block;
    }

    .imui_Navbar_actions__YCakXP {
        display: flex;
        align-items: center;
        gap: var(--space-16);
    }

    .imui_Navbar_mobileNav__NQywwb {
        display: none;
    }

    .imui_Navbar_container__Ytp59N {
        padding: var(--space-16) var(--space-80);
    }
}
