.imui_Switch_switch__pLm0kK {
    all: unset;
    width: 44px;
    height: 24px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-full);
    position: relative;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
}

.imui_Switch_switch__pLm0kK:hover {
    border-color: var(--color-border-hover);
}

.imui_Switch_switch__pLm0kK:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
}

.imui_Switch_switch__pLm0kK[data-state='checked'] {
    background: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
}

.imui_Switch_switch__pLm0kK:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.imui_Switch_thumb__eOQps7 {
    display: block;
    width: 20px;
    height: 20px;
    background: white;
    border-radius: 50%;
    transition: transform 0.2s ease;
    transform: translateX(2px);
    will-change: transform;
    box-shadow: var(--shadow-sm);
}

.imui_Switch_switch__pLm0kK[data-state='checked'] .imui_Switch_thumb__eOQps7 {
    transform: translateX(22px);
}
