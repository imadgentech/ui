.imui_MobileMenu_overlay__yxCReI {
    position: fixed;
    inset: 0;
    background: var(--color-bg-base, #050505);
    z-index: var(--z-overlay);
    /* Higher than navbar (1000) but lower than modal (1100) */
    animation: imui_MobileMenu_fadeIn__ZT5WCa 0.3s ease-out;
}

.imui_MobileMenu_content__Vr-h8v {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--color-bg-base, #050505);
    z-index: var(--z-modal);
    display: flex;
    flex-direction: column;
    animation: imui_MobileMenu_slideIn__GIHT4B 0.3s ease-out;
}

.imui_MobileMenu_content__Vr-h8v:focus {
    outline: none;
}

.imui_MobileMenu_header__yIzJkH {
    height: 80px;
    padding: 0 var(--space-24);
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.imui_MobileMenu_srOnly__KBy8iJ {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
}


.imui_MobileMenu_close___-K7ba {
    all: unset;
    cursor: pointer;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
}

.imui_MobileMenu_close___-K7ba:hover {
    background: var(--color-bg-surface-hover);
    color: var(--color-text-default);
}

.imui_MobileMenu_body__EhfmBF {
    flex: 1;
    padding: var(--space-32) var(--space-24);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
}

@keyframes imui_MobileMenu_fadeIn__ZT5WCa {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes imui_MobileMenu_slideIn__GIHT4B {
    from {
        transform: translateX(100%);
    }

    to {
        transform: translateX(0);
    }
}

@media (prefers-reduced-motion: reduce) {

    .imui_MobileMenu_overlay__yxCReI,
    .imui_MobileMenu_content__Vr-h8v {
        animation: none;
    }
}