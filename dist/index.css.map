/* Overlay */
.imui_Dialog_overlay__QIshGt {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: var(--z-overlay);
    animation: imui_Dialog_fadeIn__827-41 0.2s ease-out;
}

.imui_Dialog_overlay__QIshGt[data-state='closed'] {
    animation: imui_Dialog_fadeOut__auZt8g 0.2s ease-in;
}

/* Content */
.imui_Dialog_content__9ciCTy {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    padding: var(--space-24);
    max-width: 500px;
    width: calc(100vw - var(--space-32));
    max-height: calc(100vh - var(--space-32));
    overflow-y: auto;
    z-index: var(--z-modal);
    animation: imui_Dialog_slideIn__fEsPsz 0.2s ease-out;
}

.imui_Dialog_content__9ciCTy[data-state='closed'] {
    animation: imui_Dialog_slideOut__EIcjNs 0.2s ease-in;
}

.imui_Dialog_content__9ciCTy:focus {
    outline: none;
}

/* Header */
.imui_Dialog_header__NU5YXf {
    position: relative;
    margin-bottom: var(--space-16);
}

.imui_Dialog_title__40HiBz {
    font-size: var(--heading-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text-default);
    margin: 0;
    padding-right: var(--space-32);
}

.imui_Dialog_description__FrSdwD {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: var(--space-8) 0 0 0;
    line-height: var(--leading-relaxed);
}

/* Close button */
.imui_Dialog_close__PI4lIf {
    position: absolute;
    top: 0;
    right: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 24px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
}

.imui_Dialog_close__PI4lIf:hover {
    background: var(--color-bg-surface-hover);
    color: var(--color-text-default);
}

.imui_Dialog_close__PI4lIf:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
}

/* Body */
.imui_Dialog_body__qg5Xdj {
    /* Content goes here */
}

/* Animations */
@keyframes imui_Dialog_fadeIn__827-41 {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes imui_Dialog_fadeOut__auZt8g {
    from {
        opacity: 1;
    }

    to {
        opacity: 0;
    }
}

@keyframes imui_Dialog_slideIn__fEsPsz {
    from {
        opacity: 0;
        transform: translate(-50%, -48%);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -50%);
    }
}

@keyframes imui_Dialog_slideOut__EIcjNs {
    from {
        opacity: 1;
        transform: translate(-50%, -50%);
    }

    to {
        opacity: 0;
        transform: translate(-50%, -48%);
    }
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {

    .imui_Dialog_overlay__QIshGt,
    .imui_Dialog_content__9ciCTy {
        animation: none;
    }
}
