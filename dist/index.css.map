.imui_NavLink_navLink__Fr2dWi {
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--space-8) var(--space-16);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    position: relative;
    letter-spacing: 0.01em;
}

.imui_NavLink_navLink__Fr2dWi::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 70%;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--color-brand-primary), transparent);
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
}

.imui_NavLink_navLink__Fr2dWi:hover {
    color: var(--color-text-default);
}

.imui_NavLink_navLink__Fr2dWi:hover::after {
    transform: translateX(-50%) scaleX(1);
}

.imui_NavLink_active__RaQs0L {
    color: var(--color-text-default);
}

.imui_NavLink_active__RaQs0L::after {
    transform: translateX(-50%) scaleX(1);
    background: linear-gradient(to right, transparent, var(--color-brand-primary), transparent);
    opacity: 0.8;
}

.imui_NavLink_navLink__Fr2dWi:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
}
