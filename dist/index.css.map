.imui_Popover_content__ReVU_F {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: var(--space-16);
    box-shadow: var(--shadow-md);
    z-index: var(--z-popover);
    max-width: 320px;
    animation: imui_Popover_fadeIn__PKjphQ 0.2s ease-out;
}

.imui_Popover_content__ReVU_F:focus {
    outline: none;
}

.imui_Popover_arrow__rzANkF {
    fill: var(--color-border-default);
}

@keyframes imui_Popover_fadeIn__PKjphQ {
    from {
        opacity: 0;
        transform: translateY(-4px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
